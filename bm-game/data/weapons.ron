// Default weapon / pickup table of bm-game. Original values are NOT taken from the game; these are
// tuning numbers of this runtime. Override with a loose `Game/weapons.ron` in a mod directory or patch the
// `weapons` dataset from a script mod (see docs/game.md).
//
// `model` = weapon group of the original game (`.../weapons.zip/Weapons/<class>/<model>`, `bm screenshot --weapon <model>` shows it),
// `hold` = clip of the `Hero_1Person` set (`anm_clips <scene> Hero_1Person`; the game names it in the weapon's item definition:
// `/FirstPerson/UB_1P_Hold_*`). `parts` / `upgrade_parts` select the part ids of the modular `Custom_*` models (docs/models.md).
(
    weapons: {
        // ------------------------------------------------------------------------------------------ pistols
        "silverballer": (
            name: "Silverballer",
            hold: "UB_1P_Hold_USP",
            model: "Custom_Pistol",
            recoil_x: 1.5,
            recoil_y: -1.0,
            recoil_mode: XRandom,
            kind: Pistol,
            damage: 34.0,
            headshot_mult: 3.0,
            fire_rate: 4.0,
            auto: false,
            mag_size: 8,
            reserve: 48,
            reload_time: 1.8,
            range: 9000.0,
            spread_deg: 0.8,
            noise: 3500.0,
            concealable: true,
            fire_sound: "Weapons/FireArms/Custom_Pistol/Shot.wav",
            reload_sound: "Weapons/FireArms/Custom_Pistol/Reload.wav",
            muzzle_particle: "Gun_Flash",
            // Hardballer part ids: 1 frame, 2 clip, 3 hammer, 4 slide, 5 big clip, 6 long slide, 7 rail mount, 8 red dot sight,
            // 9 scope, 10 laser sight, 11 / 12 silencer 1 / 2, 13 long barrel, 14 barrel. Stock = frame + clip + hammer + slide + barrel.
            parts: [1, 2, 3, 4, 14],
            upgrade_parts: {
                "silencer": (add: [11]),
                "silencer2": (add: [12]),
                "laser": (add: [10]),
                "reddot": (add: [7, 8]),
                "scope": (add: [7, 9]),
                "longslide": (add: [6, 13], remove: [4, 14]),
                "bigclip": (add: [5], remove: [2]),
            },
        ),
