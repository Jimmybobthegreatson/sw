    // lower-case text before the first '_' of an `Items!WeaponsLyingAround!<Name>_<place>` node
    pickups: {
        "hammer": "hammer",
        "kitchenknife": "kitchenknife",
        "fireextinguisher": "fireextinguisher",
        "smg": "smg",
    },
    // Item names of the original game contain one of these fragments (case-insensitive, tried in key order; an item that is the
    // `model` of a weapon is found first, so only differing names need an entry here).
    item_aliases: {
        "knife": "kitchenknife",
        "hammer": "hammer",
        "extinguisher": "fireextinguisher",
        "smg": "smg",
    },
    // Weapon of an NPC role when its script does not name one; the actor's own weapon (the `ZHM3Actor` script names the item
    // definition, e.g. `Rifle_Remington_01`) always wins.
    npc_weapons: {
        "guard": "guard_pistol",
    },
    player_health: 100.0,
    npc_health: {
        "guard": 60.0,
        "civilian": 30.0,
        "target": 45.0,
